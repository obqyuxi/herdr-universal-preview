#!/usr/bin/env bash
# Self-check of the Chromium browser panel (layout herdr-preview, browser panel open).
set -euo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd); dev=$root/scripts/dev
case ${1:-} in -h|--help) echo "Usage: tests/integration/chromium-selfcheck"; exit 0 ;; esac
key=$("$dev" app do native.debug | /usr/bin/python3 -c 'import json,sys;print(next(k for k,v in json.load(sys.stdin)["views"].items() if v["kind"]=="chromium"))')
call() { local b; b=$(/usr/bin/python3 -c 'import json,sys;print(json.dumps({"key":sys.argv[1],"action":sys.argv[2],"args":json.loads(sys.argv[3])}))' "$key" "$1" "${2:-null}"); { "$dev" app do native.call "$b" 2>&1 || true; }; }
state() { call state | /usr/bin/python3 -c 'import json,sys;print(json.dumps(json.load(sys.stdin)["content"],ensure_ascii=False))'; }
check() { /usr/bin/python3 -c 'import json,sys;r=json.loads(sys.argv[2]);ok=bool(eval(sys.argv[3]));print(("PASS " if ok else "FAIL ")+sys.argv[1]);sys.exit(0 if ok else 1)' "$1" "$2" "$3"; }
fail=0
call browser.navigate '{"url":"https://www.wikipedia.org"}' >/dev/null; sleep 6
s=$(state); check "navigate to wikipedia" "$s" '"wikipedia.org" in r["url"] and not r["loading"]' || fail=1
call browser.find '{"text":"English"}' >/dev/null; sleep 1
s=$(state); check "find in page reports matches" "$s" 'r["find"] and r["find"]["matches"]>=1' || fail=1
call browser.stopFind >/dev/null
call browser.zoomIn >/dev/null; s=$(state); check "zoom in" "$s" 'r["zoomLevel"]>0' || fail=1
call browser.zoomReset >/dev/null; s=$(state); check "zoom reset" "$s" 'r["zoomLevel"]==0' || fail=1
call browser.back >/dev/null; sleep 3
s=$(state); check "back to previous page" "$s" '"example.com" in r["url"]' || fail=1
s=$(call browser.navigate '{"url":"javascript:alert(1)"}'); check "javascript: refused" "$s" '"error" in r' || fail=1
exit $fail
