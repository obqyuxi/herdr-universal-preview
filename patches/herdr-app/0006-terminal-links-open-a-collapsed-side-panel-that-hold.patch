From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: herdr-universal-preview <hup@localhost>
Date: Wed, 4 Nov 2026 02:39:44 -0800
Subject: [PATCH 6/7] terminal links: open a collapsed side panel that holds
 files-plus

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/window.rs b/src/window.rs
index 5322250..0cfa050 100644
--- a/src/window.rs
+++ b/src/window.rs
@@ -3524,6 +3524,11 @@ impl AppWindow {
                 self.run("layout.select", json!({ "stack": stack, "child": child }), window, cx);
             }
         }
+        // A collapsed side panel (the top bar's Files button hides it) opens too.
+        let hidden: Vec<String> = self.chrome.walk().into_iter().filter(|n| n.hidden && holds(n)).map(|n| n.id.clone()).collect();
+        for id in hidden {
+            self.run("layout.show", json!({ "id": id }), window, cx);
+        }
         cx.notify();
         let command = format!("{}:{}", if path.is_dir() { "reveal" } else { "open" }, path.display());
         // A panel just brought forward starts listening once it is drawn.
