From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: herdr-universal-preview <hup@localhost>
Date: Mon, 2 Nov 2026 21:02:13 -0800
Subject: [PATCH 1/4] build: skip the ghostty xcframework step (Command Line
 Tools only)

Herdr links only libghostty-vt.a. In lib-vt mode ghostty emits an
xcframework whenever an xcodebuild is on PATH, but the Command Line Tools
shim at /usr/bin/xcodebuild cannot run without a full Xcode.

diff --git a/crates/ghostty-sys/build.rs b/crates/ghostty-sys/build.rs
index 69ffe8f..1a66d68 100644
--- a/crates/ghostty-sys/build.rs
+++ b/crates/ghostty-sys/build.rs
@@ -34,7 +34,9 @@ fn main() {
     let zig = std::env::var("ZIG").unwrap_or_else(|_| "zig".into());
     let status = Command::new(&zig)
         .current_dir(&src)
-        .args(["build", "-Demit-lib-vt", "-Doptimize=ReleaseFast"])
+        // HUP: only libghostty-vt.a is linked; the xcframework step needs a full
+        // Xcode (xcodebuild), which Command Line Tools alone don't provide.
+        .args(["build", "-Demit-lib-vt", "-Demit-xcframework=false", "-Doptimize=ReleaseFast"])
         .arg(format!("-Dtarget={}", zig_target(&std::env::var("TARGET").unwrap())))
         .arg("--prefix")
         .arg(out.join("zig-out"))
