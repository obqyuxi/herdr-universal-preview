+    #[test]
+    fn file_urls_are_local_paths() {
+        let dir = std::env::temp_dir().join(format!("hup-links-{}", std::process::id()));
+        let file = dir.join("汉二密 PRD_V2.0.md");
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(&file, "x").unwrap();
+        let encoded: String = file.to_str().unwrap().bytes().map(|b| if b.is_ascii_alphanumeric() || b"/._-".contains(&b) { (b as char).to_string() } else { format!("%{b:02X}") }).collect();
+        assert_eq!(local_path(&Target::Url(format!("file://{encoded}"))), Some(file.clone()));
+        assert_eq!(local_path(&Target::Url(format!("file://localhost{encoded}#L3"))), Some(file.clone()));
+        assert_eq!(local_path(&Target::Url(format!("file://other-host{encoded}"))), None);
+        assert_eq!(local_path(&Target::Url("https://example.com/a.md".into())), None);
+        assert_eq!(local_path(&Target::File(dir.clone())), Some(dir.clone()));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
