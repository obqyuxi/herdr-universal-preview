+/// HUP: the local file or folder a target names: a path, or a `file:` URL
+/// (OSC 8 links from agents) on this machine, when it exists.
+pub fn local_path(target: &Target) -> Option<PathBuf> {
+    match target {
+        Target::File(p) => Some(p.clone()),
+        Target::Url(u) => {
+            let rest = u.strip_prefix("file://")?;
+            // `file:///p` or `file://localhost/p`; another host is not this machine.
+            let path = if rest.starts_with('/') { rest } else { rest.strip_prefix("localhost")? };
+            let path = path.split(['?', '#']).next()?;
+            let path = PathBuf::from(percent_decode(path)?);
+            path.exists().then_some(path)
+        }
+    }
+}
+
+fn percent_decode(s: &str) -> Option<String> {
+    let b = s.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == b'%' && i + 2 < b.len() {
+            let hex = std::str::from_utf8(&b[i + 1..i + 3]).ok()?;
+            out.push(u8::from_str_radix(hex, 16).ok()?);
+            i += 3;
+        } else {
+            out.push(b[i]);
+            i += 1;
+        }
+    }
+    String::from_utf8(out).ok()
+}
