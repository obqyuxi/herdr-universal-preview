+    /// HUP: shows a clicked file or folder link in the files-plus panel (bringing
+    /// its stack child forward), or hands it to the system when no such panel is laid out.
+    fn open_in_files(&mut self, path: PathBuf, window: &mut Window, cx: &mut Context<Self>) {
+        const FILES: &str = "files-plus";
+        let holds = |n: &Node| n.walk().iter().any(|b| matches!(b.content(), Some(Content::Mod { name, .. }) if name == FILES));
+        if !holds(&self.chrome) {
+            return crate::links::open(&crate::links::Target::File(path));
+        }
+        let slots: Vec<(String, String)> = self.chrome.walk().into_iter().filter_map(|s| match &s.kind {
+            Kind::Stack { children, .. } => children.iter().find(|c| holds(c)).map(|c| (s.id.clone(), c.id.clone())),
+            _ => None,
+        }).collect();
+        for (stack, child) in slots {
+            if self.chrome.active_child_id(&stack).as_deref() != Some(child.as_str()) {
+                self.run("layout.select", json!({ "stack": stack, "child": child }), window, cx);
+            }
+        }
+        cx.notify();
+        let command = format!("{}:{}", if path.is_dir() { "reveal" } else { "open" }, path.display());
+        // A panel just brought forward starts listening once it is drawn.
+        cx.spawn(async move |_, cx| {
+            for _ in 0..40 {
+                if cx.update(|_| mods::send_command(FILES, &command)) {
+                    return;
+                }
+                cx.background_executor().timer(Duration::from_millis(50)).await;
+            }
+            tracing::warn!("{FILES} did not take {command:?}; opening it with the system");
+            crate::links::open(&crate::links::Target::File(path));
+        }).detach();
+    }
+
