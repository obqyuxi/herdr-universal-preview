#!/usr/bin/env bash
# Install the build toolchain into the project only (.local/):
# Rust (rustup, pinned toolchain) and Zig, both checksum-verified; cmake and
# ninja in a uv venv (.local/py, needed to build CEF's C++ wrapper); the CEF
# binary distribution (.local/cef) via tauri-apps/cef-rs export-cef-dir.
# Never edits shell profiles, global PATH, Homebrew or system directories.
set -euo pipefail
. "$(dirname "$0")/lib/env.sh"

usage() {
  cat <<EOF
Usage: scripts/bootstrap-toolchain [--check]

Installs, into $HUP_TOOLCHAIN:
  rust  $(jq_lock rust) via rustup (--no-modify-path, minimal profile)
  zig   $(jq_lock zig)  official tarball, sha256 from ziglang.org index.json
  cmake $(jq_lock cmake), ninja $(jq_lock ninja) into $HUP_LOCAL/py (needs uv)
  CEF   $(jq_cef cef_version) into $HUP_LOCAL/cef (cef-rs $(jq_cef tag), ~1 GB download)

  --check   report what is installed; install nothing (exit 1 if incomplete)
EOF
}
jq_lock() { /usr/bin/python3 -c "import json;print(json.load(open('$HUP_ROOT/upstream.lock.json'))['toolchain']['$1'])"; }
jq_cef() { /usr/bin/python3 -c "import json;print(json.load(open('$HUP_ROOT/upstream.lock.json'))['cef']['$1'])"; }

check=0
case ${1:-} in
  -h|--help) usage; exit 0 ;;
  --check) check=1 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac

RUST=$(jq_lock rust); ZIGV=$(jq_lock zig)
hup_toolchain
mkdir -p "$HUP_TOOLCHAIN"

have_rust() { [[ -x $CARGO_HOME/bin/rustc ]] && "$CARGO_HOME/bin/rustc" --version | grep -q " $RUST "; }
have_zig() { [[ -x $ZIG ]] && [[ $("$ZIG" version) == "$ZIGV" ]]; }
have_cmake() { [[ -x $HUP_LOCAL/py/bin/cmake && -x $HUP_LOCAL/py/bin/ninja ]] && "$HUP_LOCAL/py/bin/cmake" --version | grep -q " $(jq_lock cmake)"; }
have_cef() { [[ -d "$CEF_PATH/Chromium Embedded Framework.framework" ]] && grep -q "$(jq_cef cef_version)" "$CEF_PATH/archive.json" 2>/dev/null; }

if (( check )); then
  ok=0
  have_rust && echo "rust: $("$CARGO_HOME/bin/rustc" --version)" || { echo "rust: missing ($RUST)"; ok=1; }
  have_zig && echo "zig: $("$ZIG" version)" || { echo "zig: missing ($ZIGV)"; ok=1; }
  have_cmake && echo "cmake/ninja: $HUP_LOCAL/py" || { echo "cmake/ninja: missing"; ok=1; }
  have_cef && echo "cef: $CEF_PATH" || { echo "cef: missing ($(jq_cef cef_version))"; ok=1; }
  exit $ok
fi

tmp=$(mktemp -d "$HUP_TOOLCHAIN/dl.XXXX"); trap 'rm -rf "$tmp"' EXIT

if ! have_rust; then
  echo "== rustup-init (aarch64-apple-darwin)"
  base=https://static.rust-lang.org/rustup/dist/aarch64-apple-darwin
  curl -fsSL "$base/rustup-init" -o "$tmp/rustup-init"
  want=$(curl -fsSL "$base/rustup-init.sha256" | awk '{print $1}')
  got=$(shasum -a 256 "$tmp/rustup-init" | awk '{print $1}')
  [[ $want == "$got" ]] || hup_die "rustup-init checksum mismatch ($got != $want)"
  chmod +x "$tmp/rustup-init"
  "$tmp/rustup-init" -y --no-modify-path --profile minimal --default-toolchain "$RUST" \
    --component rustfmt --component clippy
  have_rust || hup_die "rust $RUST not usable after install"
fi
echo "rust: $("$CARGO_HOME/bin/rustc" --version)"

if ! have_zig; then
  echo "== zig $ZIGV (aarch64-macos)"
  read -r url sum < <(curl -fsSL https://ziglang.org/download/index.json | /usr/bin/python3 -c \
    "import json,sys;d=json.load(sys.stdin)['$ZIGV']['aarch64-macos'];print(d['tarball'],d['shasum'])")
  curl -fsSL "$url" -o "$tmp/zig.tar.xz"
  got=$(shasum -a 256 "$tmp/zig.tar.xz" | awk '{print $1}')
  [[ $got == "$sum" ]] || hup_die "zig checksum mismatch ($got != $sum)"
  rm -rf "$HUP_TOOLCHAIN/zig"; mkdir -p "$HUP_TOOLCHAIN/zig"
  tar -xJf "$tmp/zig.tar.xz" -C "$HUP_TOOLCHAIN/zig" --strip-components 1
  have_zig || hup_die "zig $ZIGV not usable after install"
fi
echo "zig: $("$ZIG" version)"

if ! have_cmake; then
  echo "== cmake $(jq_lock cmake), ninja $(jq_lock ninja) (uv venv $HUP_LOCAL/py)"
  command -v uv >/dev/null || hup_die "uv is needed for cmake/ninja: https://docs.astral.sh/uv/"
  uv venv --quiet --allow-existing "$HUP_LOCAL/py"
  uv pip install --quiet --python "$HUP_LOCAL/py" "cmake==$(jq_lock cmake)" "ninja==$(jq_lock ninja)"
  have_cmake || hup_die "cmake/ninja not usable after install"
fi
echo "cmake/ninja: $HUP_LOCAL/py"

if ! have_cef; then
  echo "== CEF $(jq_cef cef_version) (cef-rs $(jq_cef tag))"
  src=$HUP_WORK/cef-rs
  [[ -d $src/.git ]] || git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$(jq_cef tag)" "$(jq_cef repo)" "$src"
  [[ $(git -C "$src" rev-parse HEAD) == "$(jq_cef commit)" ]] || hup_die "cef-rs at $(git -C "$src" rev-parse HEAD), expected $(jq_cef commit)"
  (cd "$src" && cargo run -q -p export-cef-dir -- --force "$CEF_PATH")
  have_cef || hup_die "CEF not usable after export (see $CEF_PATH)"
fi
echo "cef: $CEF_PATH"
