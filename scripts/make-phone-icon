#!/usr/bin/env python3
"""Draw the phone app's pixel-art icon (32x32 grid, 32 px per pixel) into the
HarmonyOS media folders. No dependencies: writes the PNG with zlib.

  scripts/make-phone-icon            write app_icon.png (1024x1024, full bleed)
  scripts/make-phone-icon OUT.png    write somewhere else (preview)

The picture: a terminal window with a ">" prompt and cursor, and an arrow
rising out of it ("码上": code, right away). Opaque and full bleed, because
HarmonyOS masks icons itself; everything important sits in the middle 24x24.
"""
import struct, sys, zlib
from pathlib import Path

N, S = 32, 32  # grid, pixels per cell

def hexc(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))

grid = [[None] * N for _ in range(N)]

def put(x, y, c):
    if 0 <= x < N and 0 <= y < N:
        grid[y][x] = hexc(c)

def rect(x0, y0, x1, y1, c):
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            put(x, y, c)

# Background: indigo to near-black in bands, dithered where they meet.
bands = ["#2B3070", "#232861", "#1C2052", "#161A43", "#111435", "#0C0F27"]
for y in range(N):
    for x in range(N):
        t = (y + x * 0.35) / (N + N * 0.35) * len(bands)
        i = min(int(t), len(bands) - 1)
        frac = t - int(t)
        # checkerboard in the last third of a band: the next band shows through
        if frac > 0.66 and (x + y) % 2 == 0 and i + 1 < len(bands):
            i += 1
        put(x, y, bands[i])

# Sparkle pixels (a little life in the corners).
for x, y in [(4, 4), (27, 6), (3, 26), (28, 27)]:
    put(x, y, "#3A40A0")

# Window shadow, frame, title bar, body.
rect(7, 10, 26, 27, "#070916")
rect(5, 8, 25, 26, "#E8ECFF")          # outline
rect(6, 9, 24, 11, "#3D4596")          # title bar
rect(6, 12, 24, 25, "#0E1130")         # body
for x, c in [(8, "#FF6B6B"), (10, "#FFC857"), (12, "#5BF2C2")]:
    put(x, 10, c)

# Prompt ">" and cursor.
for x, y in [(8, 15), (9, 16), (10, 17), (9, 18), (8, 19)]:
    put(x, y, "#5BF2C2")
rect(12, 19, 15, 19, "#F4F6FF")
# Faint code lines.
rect(8, 22, 13, 22, "#2E3576")
rect(15, 22, 17, 22, "#2E3576")
rect(8, 24, 11, 24, "#2E3576")

# Rising arrow: from inside the window up through the title bar and out,
# with a dark outline so it reads where it crosses the frame.
grad = ["#5BF2C2", "#4FE3CB", "#43D3D4", "#37C3DE", "#2BB4E7", "#1FA8F0"]
arrow = {}
for y, half in [(3, 0), (4, 1), (5, 2), (6, 3)]:
    for x in range(21 - half, 22 + half):
        arrow[(x, y)] = grad[y - 3]
for y in range(7, 21):
    for x in (20, 21, 22):
        arrow[(x, y)] = grad[min((y - 7) // 3 + 1, 5)]
for (x, y) in arrow:
    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
        if (x + dx, y + dy) not in arrow:
            put(x + dx, y + dy, "#070916")
for (x, y), c in arrow.items():
    put(x, y, c)

out = Path(sys.argv[1]) if len(sys.argv) > 1 else None
raw = bytearray()
for py in range(N * S):
    raw.append(0)
    row = grid[py // S]
    for px in range(N * S):
        raw.extend(row[px // S])
def chunk(t, d):
    return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)
png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", N * S, N * S, 8, 2, 0, 0, 0)) \
    + chunk(b"IDAT", zlib.compress(bytes(raw), 9)) + chunk(b"IEND", b"")
root = Path(__file__).resolve().parent.parent
targets = [out] if out else [root / "mobile/harmony/AppScope/resources/base/media/app_icon.png",
                             root / "mobile/harmony/entry/src/main/resources/base/media/app_icon.png"]
for t in targets:
    t.write_bytes(png)
    print(t)
