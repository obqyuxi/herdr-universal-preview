#!/usr/bin/env python3
"""Draw the phone app's pixel-art icon into the HarmonyOS media folders.
No dependencies: writes the PNG with zlib.

  scripts/make-phone-icon            write both app_icon.png (1024x1024, full bleed)
  scripts/make-phone-icon OUT.png    write a preview somewhere else

The picture (D33): a little terminal robot whose face is a ">_" prompt, an
antenna with a yellow light, on a mint-to-sky tile. 16x16 cells of 64 px.
Opaque and full bleed: HarmonyOS rounds the corners itself.
"""
import struct, sys, zlib
from pathlib import Path

ART = [
    "................",
    ".......G........",
    ".......L........",
    "...OOOOOOOOO....",
    "..OLLLLLLLLLO...",
    ".OLLKKKKKKKLLO..",
    ".OLKKKKKKKKKLO..",
    ".OLKMKKKKKKKLO..",
    ".OLKKMKKKKKKLO..",
    ".OLKMKKMMMKKLO..",
    ".OLKKKKKKKKKLO..",
    ".OLLKKKKKKKLLO..",
    "..OLLLLLLLLLO...",
    "...OOOOOOOOO....",
    "....OO...OO.....",
    "................",
]
PALETTE = {'O': "#0A0C22", 'L': "#E8ECFF", 'K': "#11163A", 'M': "#5BF2C2", 'G': "#FFC857"}
BACKGROUND = ["#6FF5CB", "#55E6D2", "#3DD3DE", "#2ABDEA", "#1FA8F0"]  # diagonal bands, top-left to bottom-right
N, CELL = 16, 64


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def colour(x, y):
    c = ART[y][x]
    if c != '.':
        return rgb(PALETTE[c])
    t = (x + y) / (2 * N - 1)
    return rgb(BACKGROUND[min(int(t * len(BACKGROUND)), len(BACKGROUND) - 1)])


def png():
    grid = [[colour(x, y) for x in range(N)] for y in range(N)]
    raw = bytearray()
    for py in range(N * CELL):
        raw.append(0)
        row = grid[py // CELL]
        for px in range(N * CELL):
            raw.extend(row[px // CELL])

    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)

    size = N * CELL
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(bytes(raw), 9)) + chunk(b"IEND", b""))


assert len(ART) == N and all(len(r) == N for r in ART)
root = Path(__file__).resolve().parent.parent
targets = [Path(sys.argv[1])] if len(sys.argv) > 1 else [
    root / "mobile/harmony/AppScope/resources/base/media/app_icon.png",
    root / "mobile/harmony/entry/src/main/resources/base/media/app_icon.png",
]
data = png()
for t in targets:
    t.write_bytes(data)
    print(t)
