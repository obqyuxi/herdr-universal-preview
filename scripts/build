#!/usr/bin/env bash
# Build herdr-app from the pinned work copy and wrap it as "Herdr Preview Dev.app"
# (own name, bundle id and executable; ad-hoc signed; never self-updates).
set -euo pipefail
. "$(dirname "$0")/lib/env.sh"

usage() {
  cat <<EOF
Usage: scripts/build [--release] [--daily] [--baseline] [--no-bundle] [-- cargo-args...]

  (default)    cargo build (debug) in $HUP_UPSTREAM, then bundle it as
               artifacts/Herdr Preview Dev.app
  --release    optimized build
  --daily      the everyday edition, named in brand.env (artifacts/<APP_NAME>.app;
               release, uses the normal ~/.config/herdr-app; no dev guard, no
               isolated environment). Install with scripts/install
  --baseline   build the work copy as-is without the dev bundle (used for the
               unpatched M0 toolchain check); implies --no-bundle
  --no-bundle  skip the app bundle
Run scripts/prepare-upstream first. Logs: .local/logs/build-*.log
EOF
}

profile=debug bundle=1 daily=0 extra=()
while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --release) profile=release ;;
    --daily) profile=release daily=1 ;;
    --baseline|--no-bundle) bundle=0 ;;
    --) shift; extra=("$@"); break ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

[[ -d $HUP_UPSTREAM/.git ]] || hup_die "no work copy; run scripts/prepare-upstream"
hup_toolchain
[[ -x $CARGO_HOME/bin/cargo && -x $ZIG ]] || hup_die "toolchain missing; run scripts/bootstrap-toolchain"
# Never a release/updating build: src/update.rs only updates with these set.
unset HERDR_APP_RELEASE HERDR_RELEASES_URL
if (( daily )); then
  unset HUP_DEV_BUILD
  . "$HUP_ROOT/brand.env"
  app="$HUP_ROOT/artifacts/$APP_NAME.app"
else
  export HUP_DEV_BUILD=1          # read by our patch: refuse to run without an isolated home
  APP_NAME="Herdr Preview Dev" APP_EXE=HerdrPreviewDev APP_ID=dev.herdr.app.preview-dev
  app=$HUP_DEV_APP
fi
args=(build --locked)
[[ $profile == release ]] && args+=(--release)

log=$HUP_LOGS/build-$profile.log
mkdir -p "$HUP_LOGS"
echo "cargo ${args[*]} ${extra[*]+"${extra[*]}"} (log: $log)"
start=$SECONDS
if ! (cd "$HUP_UPSTREAM" && cargo "${args[@]}" ${extra[@]+"${extra[@]}"}) >"$log" 2>&1; then
  tail -40 "$log" >&2
  hup_die "cargo build failed after $((SECONDS - start))s"
fi
echo "built in $((SECONDS - start))s: $HUP_UPSTREAM/target/$profile/herdr-app"
(( bundle )) || exit 0

version=$(cd "$HUP_UPSTREAM" && sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
rev=$(git -C "$HUP_UPSTREAM" rev-parse --short HEAD)
# Keep the (large) Chromium framework between builds; rebuild everything else.
if [[ -d $app ]]; then
  find "$app/Contents" -mindepth 1 -maxdepth 1 ! -name Frameworks -exec rm -rf {} +
  find "$app/Contents/Frameworks" -mindepth 1 -maxdepth 1 -name '*Helper*.app' -exec rm -rf {} + 2>/dev/null || true
fi
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$app/Contents/Frameworks"
cp "$HUP_UPSTREAM/target/$profile/herdr-app" "$app/Contents/MacOS/$APP_EXE"
icon=$HUP_UPSTREAM/assets/icons/Herdr.icns
(( daily )) && [[ -f $HUP_ROOT/assets/icon/AppIcon.icns ]] && icon=$HUP_ROOT/assets/icon/AppIcon.icns
cp "$icon" "$app/Contents/Resources/$APP_EXE.icns"
cp "$HUP_UPSTREAM/LICENSE" "$HUP_UPSTREAM/THIRD-PARTY-NOTICES" "$app/Contents/Resources/"
# Dev: LSEnvironment gives even a Finder/Dock launch the isolated home, core and
# session. Daily: the normal home and core, like the official app.
if (( daily )); then
  lsenv=""
else
  lsenv="
        <key>HERDR_APP_HOME</key><string>$HUP_APP_HOME</string>
        <key>HC_SESSION</key><string>$HUP_SESSION</string>
        <key>XDG_STATE_HOME</key><string>$HUP_SHORT/state</string>
        <key>XDG_CONFIG_HOME</key><string>$HUP_SHORT/config</string>
        <key>HERDR_CORE_DIRS</key><string>$HUP_BIN</string>
        <key>HC_INSTALL_DIR</key><string>$HUP_BIN</string>
        <key>HERDR_APP_NO_SOUND</key><string>1</string>
        <key>HERDR_TELEMETRY</key><string>0</string>
        <key>HUP_CHROMIUM_PROFILE</key><string>$HUP_LOCAL/chromium-profile</string>
    "
fi
cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>$APP_EXE</string>
    <key>CFBundleIdentifier</key><string>$APP_ID</string>
    <key>CFBundleName</key><string>$APP_NAME</string>
    <key>CFBundleDisplayName</key><string>$APP_NAME</string>
    <key>CFBundleIconFile</key><string>$APP_EXE</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version-hup.$rev</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr can use AppleScript to control other apps.</string>
    <key>LSEnvironment</key><dict>$lsenv</dict>
</dict></plist>
PLIST
plutil -lint "$app/Contents/Info.plist" >/dev/null

# Chromium: the CEF framework and five helper apps (GPU, renderer, plugin, alerts, utility).
[[ -d "$CEF_PATH/Chromium Embedded Framework.framework" ]] || hup_die "no CEF at $CEF_PATH (run .work/cef-rs export-cef-dir, see docs/DECISIONS.md D10)"
rsync -a --delete "$CEF_PATH/Chromium Embedded Framework.framework" "$app/Contents/Frameworks/"
cp "$CEF_PATH/CREDITS.html" "$app/Contents/Resources/CEF-CREDITS.html"
hlog=$HUP_LOGS/build-cef-helper.log
hargs=(build --manifest-path "$HUP_ROOT/native/herdr-native-view/Cargo.toml" --features chromium --bin herdr-cef-helper)
[[ $profile == release ]] && hargs+=(--release)
CARGO_TARGET_DIR=$HUP_LOCAL/target-native cargo "${hargs[@]}" >"$hlog" 2>&1 || { tail -30 "$hlog" >&2; hup_die "helper build failed"; }
helper_bin=$HUP_LOCAL/target-native/$profile/herdr-cef-helper
for suffix in "" " (GPU)" " (Renderer)" " (Plugin)" " (Alerts)"; do
  name="$APP_EXE Helper$suffix"
  h="$app/Contents/Frameworks/$name.app"
  mkdir -p "$h/Contents/MacOS"
  cp "$helper_bin" "$h/Contents/MacOS/$name"
  id_suffix=$(printf '%s' "$suffix" | tr -d ' ()' | tr '[:upper:]' '[:lower:]')
  cat >"$h/Contents/Info.plist" <<HPLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>$name</string>
    <key>CFBundleIdentifier</key><string>$APP_ID.helper${id_suffix:+.$id_suffix}</string>
    <key>CFBundleName</key><string>$name</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>LSUIElement</key><string>1</string>
    <key>LSEnvironment</key><dict><key>MallocNanoZone</key><string>0</string></dict>
    <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
</dict></plist>
HPLIST
done
codesign --force --deep --sign - "$app" 2>/dev/null
codesign --verify --deep "$app"
echo "bundle: $app ($version-hup.$rev, $APP_ID, ad-hoc signed, $(du -sh "$app" | cut -f1) with Chromium)"
