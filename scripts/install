#!/usr/bin/env bash
# Install Herdr Plus (the everyday edition) beside the official Herdr.
# Adds the app, three mods and one layout; records them in a manifest.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
case ${1:-} in
  -h|--help) cat <<USAGE
Usage: scripts/install [--dry-run] [--app-dir DIR]

  Build first: scripts/build --daily (artifacts/Herdr Plus.app).
  Adds  DIR/Herdr Plus.app (default ~/Applications),
        ~/.config/herdr-app/mods/{files-plus,browser,tabs-plus},
        ~/.config/herdr-app/layouts/herdr-plus.json
  Refuses anything that exists and isn't ours. Never touches /Applications/Herdr.app,
  built-in mods/layouts, workspaces, terminals or agent sessions.
  --dry-run   list what would change; change nothing
  Undo: scripts/uninstall (or scripts/rollback)
USAGE
  exit 0 ;;
esac
exec /usr/bin/python3 -I "$here/lib/install.py" install "$@"
